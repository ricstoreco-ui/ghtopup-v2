const { createClient } = require('@supabase/supabase-js');

exports.handler = async (event) => {
  // Telegram selalu pakai POST
  if (event.httpMethod !== 'POST') return { statusCode: 200, body: 'ok' };

  const update = JSON.parse(event.body);

  // Pastiin ini dari klik tombol (callback_query)
  if (!update.callback_query) return { statusCode: 200, body: 'ok' };

  const cq = update.callback_query;
  const [action, invoice] = cq.data.split(':');
  const token = process.env.TELEGRAM_BOT_TOKEN;
  
  // Konek ke Supabase pakai Kunci Master
  const sb = createClient(
    process.env.SUPABASE_URL,
    process.env.SUPABASE_SERVICE_KEY
  );

  // Mapping tombol ke status database
  const statusMap = {
    processing: 'processing',
    success: 'success',
    failed: 'failed'
  };
  
  const newStatus = statusMap[action];
  let replyText;

  if (!newStatus) {
    replyText = '⚠️ Aksi tidak dikenal';
  } else {
    // Update status di tabel orders
    const { error } = await sb.from('orders')
      .update({ status: newStatus, updated_at: new Date().toISOString() })
      .eq('invoice', invoice);

    replyText = error
      ? `⚠️ Gagal update database: ${error.message}`
      : `✅ Invoice ${invoice} berhasil diubah jadi *${newStatus.toUpperCase()}*`;
  }

  // 1. Hilangin loading di tombol Telegram & kasih notif kecil
  await fetch(`https://api.telegram.org/bot${token}/answerCallbackQuery`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      callback_query_id: cq.id,
      text: replyText,
      parse_mode: 'Markdown'
    })
  });

  // 2. Hapus tombol dari pesan biar gak diklik 2x
  await fetch(`https://api.telegram.org/bot${token}/editMessageReplyMarkup`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      chat_id: cq.message.chat.id,
      message_id: cq.message.message_id,
      reply_markup: { inline_keyboard: [] } // Kosongin tombol
    })
  });

  return { statusCode: 200, body: 'ok' };
};
